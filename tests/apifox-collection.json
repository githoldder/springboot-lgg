  "item": [
    {
      "name": "Gateway - Get Captcha",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Captcha endpoint returns success\", function () {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData.code).to.eql(200);",
              "  pm.expect(jsonData).to.have.property('captchaEnabled');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8090/captchaImage",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8090",
          "path": ["captchaImage"]
        }
      },
      "response": []
    },
    {
      "name": "Gateway - Admin Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Login returns admin token\", function () {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData.code).to.eql(200);",
              "  pm.expect(jsonData.token).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('adminToken', jsonData.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"admin\",\"password\":\"admin123\",\"code\":\"\",\"uuid\":\"\"}"
        },
        "url": {
          "raw": "http://127.0.0.1:8090/login",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8090",
          "path": ["login"]
        }
      },
      "response": []
    },
    {
      "name": "Business - Category List",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Category list has seeded data\", function () {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData.code).to.eql(1);",
              "  pm.expect(jsonData.data).to.be.an('array').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer demo"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8088/admin/category/list?page=1&pageSize=5",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8088",
          "path": ["admin", "category", "list"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "5"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Business - Order Search",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Order search returns paged records\", function () {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData.code).to.eql(1);",
              "  pm.expect(jsonData.data).to.have.property('records');",
              "  pm.expect(jsonData.data.records).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer demo"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8088/admin/order/conditionSearch?page=1&pageSize=5",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8088",
          "path": ["admin", "order", "conditionSearch"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "5"
            }
          ]
        }
