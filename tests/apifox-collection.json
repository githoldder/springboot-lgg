{
  "info": {
    "_postman_id": "8b84d4fa-d55a-471a-b6b6-d5f98cf4a1bb",
    "name": "GreenFruit API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
