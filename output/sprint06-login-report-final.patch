+
+.PHONY: all build pdf clean cleanall view
+
+all: build
+
+build: pdf
+
+pdf:
+	cd $(LATEX_DIR) && \
+	$(LATEXMK) -interaction=nonstopmode $(MAIN) && \
+	$(BIBTEX) $(MAIN) && \
+	$(LATEXMK) -interaction=nonstopmode $(MAIN) && \
