{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build template.pdf",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-interaction=nonstopmode",
        "-synctex=1",
        "template"
      ],
      "options": {
        "cwd": "${workspaceFolder}/docs/03-report/实训文档/templates"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
